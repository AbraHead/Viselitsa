<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModel="clr-namespace:Viselitsa.ViewModel"
             x:Class="Viselitsa.View.Pages.MainPage">
    <ContentPage.BindingContext>
        <ViewModel:MainPageViewModel></ViewModel:MainPageViewModel>
    </ContentPage.BindingContext>
    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*">
        <Image Grid.Column="1" Grid.Row="0" Source="viselica.png" HeightRequest="100"></Image>
        <Label Grid.Column="1" Grid.Row="1" Text="ВИСЕЛИЦА" Style="{StaticResource Headline}"></Label>
        <VerticalStackLayout Grid.Column="1" Grid.Row="2" Spacing="5">
            <Button Text="Начать!" Command="{Binding GoToGamePageCommand}"></Button>
            <Button Text="Выход"></Button>
        </VerticalStackLayout>
    </Grid>
